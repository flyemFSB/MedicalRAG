# Copy to .env; Compose interpolates these values.
# Local defaults are fine; production must set values marked required.

# --- PostgreSQL ---
POSTGRES_USER=medicalrag
POSTGRES_PASSWORD=medicalrag          # required in production
POSTGRES_DB=medicalrag

# --- RabbitMQ (durable task transport, ADR 0086) ---
RABBITMQ_USER=medicalrag
RABBITMQ_PASSWORD=medicalrag          # required in production

# --- Redis (sessions / rate limit / concurrency gate / worker heartbeat) ---
REDIS_PASSWORD=medicalrag             # required in production

# --- Retrieval / Qdrant ---
MEDICALRAG_QDRANT_COLLECTION=medical_chunks_v1
MEDICALRAG_QDRANT_EMBEDDING_DIM=1536
MEDICALRAG_RETRIEVAL_POLICY_VERSION=2
MEDICALRAG_RETRIEVAL_CONTEXT_CAP=8
MEDICALRAG_RETRIEVAL_INTENT_MIN_SCORE=0.35  # intent confidence floor (0 disables)
MEDICALRAG_RETRIEVAL_RERANK_CANDIDATE_LIMIT=40  # rerank cost ceiling (0 disables)

# --- LLM provider (OpenAI-compatible) ---
MEDICALRAG_LLM_BASE_URL=https://api.openai.com
MEDICALRAG_LLM_API_KEY=               # required: chat / embedding / classify
MEDICALRAG_LLM_MODEL=gpt-4o-mini

# --- Embedding / ingestion (optional) ---
MEDICALRAG_EMBEDDING_MODEL=text-embedding-3-small
MEDICALRAG_CONTEXT_MODEL=             # empty disables chunk context rewrite
MEDICALRAG_RERANK_MODEL=              # empty disables external reranker
MEDICALRAG_MINERU_BASE_URL=           # empty disables MinerU (Multimodal parse)
MEDICALRAG_MINERU_TOKEN=
MEDICALRAG_MINERU_CONCURRENCY=16      # cross-process parse concurrency ceiling

# --- Chat (agent runtime) ---
MEDICALRAG_RETRIEVAL_EVIDENCE_MIN_SCORE=0  # >0 enables evidence gate (e.g. 0.2)
MEDICALRAG_CHAT_MAX_CONCURRENT=10     # global concurrent chat slots (queue beyond this)
MEDICALRAG_CHAT_QUEUE_WAIT_S=15       # queue wait budget before 429 reject
MEDICALRAG_LLM_FIRST_PACKET_TIMEOUT_S=30  # first-packet probe budget per model candidate

# --- API ---
MEDICALRAG_COOKIE_SECURE=false        # must be true behind HTTPS
MEDICALRAG_OPERATOR_EMAILS=           # comma-separated operator console emails
MEDICALRAG_LOG_LEVEL=INFO
MEDICALRAG_AUTH_RATE_LIMIT=10         # login attempts per source IP per window
MEDICALRAG_AUTH_RATE_WINDOW_S=60      # login rate-limit window (seconds)

# --- Worker ---
MEDICALRAG_STALE_RUN_SECONDS=900       # stale ingestion run self-heal threshold
MEDICALRAG_OUTBOX_MAX_ATTEMPTS=5       # poison-message retry ceiling before claim skips

# --- HuggingFace mirror (fastembed sparse model download) ---
HF_ENDPOINT=https://hf-mirror.com

# --- Observability (--profile observability) ---
OTEL_TARGETS=PHOENIX
PHOENIX_SECRET=                      # required: openssl rand -hex 32
PHOENIX_API_KEY=                     # required: system API key from Phoenix Settings
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=admin  # first boot only; change immediately
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=90
PHOENIX_ENABLE_AUTH=true

# --- Integration tests (--profile test) ---
# MEDICALRAG_TEST_DATABASE_URL=postgresql+asyncpg://medicalrag_test:medicalrag_test@127.0.0.1:5433/medicalrag_test
