# MedicalRAG 环境变量样例 —— 复制为 .env 后按需修改（compose 自动读取）。
# 约定：本地开发可用默认值；任何对外部署必须显式设置带「必填」标记的项。

# --- PostgreSQL（核心业务库；agent 的 Aegra 库由 db-init 自动创建） ---
POSTGRES_USER=medicalrag
POSTGRES_PASSWORD=medicalrag          # 对外部署必填：改强密码
POSTGRES_DB=medicalrag

# --- LLM Provider（ADR 0009/0010；OpenAI 兼容端点） ---
MEDICALRAG_LLM_BASE_URL=https://api.openai.com
MEDICALRAG_LLM_API_KEY=               # 必填：聊天/嵌入/分类能力来源
MEDICALRAG_LLM_MODEL=gpt-4o-mini

# --- 检索 / 摄取可选外部服务 ---
MEDICALRAG_MINERU_BASE_URL=           # 留空禁用 MinerU（Multimodal 格式将无法摄取）
MEDICALRAG_MINERU_TOKEN=
MEDICALRAG_EMBEDDING_MODEL=text-embedding-3-small
MEDICALRAG_CONTEXT_MODEL=             # 留空禁用 Chunk 背景补写（ADR 0078）
MEDICALRAG_RERANK_MODEL=              # 留空禁用外部 Reranker（ADR 0037）

# --- API 行为 ---
MEDICALRAG_COOKIE_SECURE=false        # 生产（https）必填 true（__Host- cookie）
MEDICALRAG_OPERATOR_EMAILS=           # 逗号分隔的运营控制台账号邮箱
MEDICALRAG_LOG_LEVEL=INFO

# --- 可观测 profile（--profile observability 启用自托管 Phoenix，Postgres 后端，ADR 0082） ---
OTEL_TARGETS=PHOENIX                 # 启用 observability 时必设；不设则 agent 不导出 trace（fail-open）
PHOENIX_SECRET=                      # 启用 observability 时必填：签发 JWT 的长随机串（openssl rand -hex 32）
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=admin  # 仅首启创建 admin@localhost 时生效；首启后立即改密
PHOENIX_API_KEY=                     # 启用时必填：Phoenix Settings 创建的 system API key（aegra 导出鉴权）
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=90  # Trace 保留天数（有界保留，ADR 0072/0082）
